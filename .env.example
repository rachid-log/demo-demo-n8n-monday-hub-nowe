# ==============================================================================
# CreaBeast VPS Prototype Environment Configuration
# ==============================================================================

# Subdomain for Traefik routing:
# The prototype will be reachable at https://${SUBDOMAIN}.creabeast.com
SUBDOMAIN=demo

# Compose Project Name (prefixes container names and default networks)
COMPOSE_PROJECT_NAME=prototype

# Node Environment
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Database Connection:
#
# Option A: Local Docker PostgreSQL service (when using `docker compose --profile with-db up -d`)
DATABASE_URL="postgresql://postgres:postgres@db:5432/prototype?schema=public"

# Option B: External PostgreSQL (Neon, Supabase, RDS)
# DATABASE_URL="postgresql://user:password@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require"

# PostgreSQL credentials for the local `db` service container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prototype

# Migration runner flag: run `prisma migrate deploy` on startup if DATABASE_URL is set
RUN_MIGRATIONS=true
